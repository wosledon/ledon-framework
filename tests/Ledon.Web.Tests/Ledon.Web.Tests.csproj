<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!-- gRPC 测试夹具：用真实 protoc 生成代码验证服务发现与映射 -->
        <PackageReference Include="Grpc.Tools" />
        <!-- OpenIddict.Validation.SystemNetHttp 传递引入 Polly v7（与 Ledon.Resilience 的 Polly.Core v8 同名类型冲突）：
             加别名隔离，默认查找只看 Polly.Core；polly7 别名保留给传递依赖本身。 -->
        <PackageReference Include="Polly" Aliases="polly7" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Ledon.Web\Ledon.Web.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Data\Ledon.Data.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Caching\Ledon.Caching.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Queues\Ledon.Queues.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Queues.RabbitMQ\Ledon.Queues.RabbitMQ.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Queues.Kafka\Ledon.Queues.Kafka.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Grpc\Ledon.Grpc.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Serilog\Ledon.Serilog.csproj" />
        <ProjectReference Include="..\..\src\Ledon.FluentValidation\Ledon.FluentValidation.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Aspire\Ledon.Aspire.csproj" />
        <ProjectReference Include="..\..\src\Ledon.SignalR\Ledon.SignalR.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Configuration.Nacos\Ledon.Configuration.Nacos.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Configuration.Apollo\Ledon.Configuration.Apollo.csproj" />
        <ProjectReference Include="..\..\src\Ledon.OpenIddict\Ledon.OpenIddict.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Observability\Ledon.Observability.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Security\Ledon.Security.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Scheduling\Ledon.Scheduling.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Resilience\Ledon.Resilience.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Configuration\Ledon.Configuration.csproj" />
        <ProjectReference Include="..\..\src\Ledon.MultiTenancy\Ledon.MultiTenancy.csproj" />
        <ProjectReference Include="..\..\src\Ledon.Testing\Ledon.Testing.csproj" />    </ItemGroup>

    <ItemGroup>
        <!-- gRPC 测试夹具：真实 protoc 生成代码（验证服务发现与约定映射） -->
        <Protobuf Include="Protos\testgreeter.proto" GrpcServices="Server,Client" />
    </ItemGroup>

</Project>