<Project>

    <PropertyGroup>
        <!-- Microsoft.AspNetCore.OpenApi 的源生成器会发出拦截器代码，
         消费该包（含经 Ledon.Web 间接引用）且使用最小 API 映射的项目必须显式启用。
         打包为 NuGet 时应改由 buildTransitive/Ledon.Web.props 向使用方传递。 -->
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
        <!-- 框架自身大量调用标注了 [RequiresDynamicCode] 的反射入口（AddLedon 等）：
             这些调用是框架内部行为，不应对框架自身的构建告警；裁剪警告会在
             **使用方**调用这些入口时出现（预期的边界提示），那里不抑制。 -->
        <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
    </PropertyGroup>

    <!-- 打包元数据（测试/示例项目 IsPackable=false，不产出包） -->
    <PropertyGroup>
        <Authors>wosledon</Authors>
        <Product>Ledon Framework</Product>
        <Description>.NET 10 模块化 Web 开发框架：解耦优先，自动发现与自动注入，能力按需引入。</Description>
        <RepositoryUrl>https://github.com/wosledon/ledon-framework</RepositoryUrl>
        <PackageProjectUrl>https://github.com/wosledon/ledon-framework</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <VersionPrefix>0.1.0</VersionPrefix>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- 测试与示例项目不打包 -->
        <IsPackable
            Condition="'$(IsPackable)' == '' AND ($(MSBuildProjectDirectory.Contains('\samples\')) OR $(MSBuildProjectDirectory.Contains('\tests\')))">
            false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- 包 README：包目录下有自定义 README 时优先（NuGet 包页展示），否则用仓库根 README -->
        <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\"
            Condition="!Exists('README.md') And '$(IsPackable)' != 'false'" />
    </ItemGroup>

</Project>