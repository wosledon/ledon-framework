@page "/login"
@rendermode InteractiveServer
@inject AuthApi Api
@inject NavigationManager Nav

<PageTitle>登录</PageTitle>

<h1>登录</h1>
<p class="hint">演示：admin / admin123 或 user / user123</p>

<div class="card">
    <label>
        用户名
        <input @bind="userName" autocomplete="username" />
    </label>
    <label>
        密码
        <input @bind="password" type="password" autocomplete="current-password" />
    </label>

    <div class="actions">
        <button @onclick="LoginAsync" disabled="@busy">登录</button>
        <button @onclick="LoginAdminAsync" disabled="@busy">管理员演示</button>
        <button @onclick="LoginUserAsync" disabled="@busy">普通用户演示</button>
    </div>

    @if (error is not null)
    {
        <p class="error">@error</p>
    }
</div>

@code {
    private string userName = "admin";
    private string password = "admin123";
    private string? error;
    private bool busy;

    private async Task LoginAsync()
    {
        busy = true;
        error = null;

        try
        {
            if (await Api.LoginAsync(userName, password))
                Nav.NavigateTo("/rbac");
            else
                error = "用户名或密码错误";
        }
        finally
        {
            busy = false;
        }
    }

    private Task LoginAdminAsync()
    {
        userName = "admin";
        password = "admin123";
        return LoginAsync();
    }

    private Task LoginUserAsync()
    {
        userName = "user";
        password = "user123";
        return LoginAsync();
    }
}
